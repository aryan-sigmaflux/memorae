# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
API_BASE_URL=https://your-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
# NOTE: When running via docker compose, DATABASE_URL is set automatically and
# this value is ignored. Only needed for a bare (non-Docker) run.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/memorae

# ── Docker compose infra (only used by docker-compose.yml) ────────────────────
# These configure the bundled Postgres + MinIO containers. Change the passwords
# before deploying. The app reaches them by service name automatically.
POSTGRES_USER=memorae
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memorae
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
ALLOWED_CHAT_IDS=[]

# ── AI ────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=anthropic/claude-opus-4                # any model slug from openrouter.ai/models
AI_MAX_TOKENS=1024
OPENROUTER_SITE_URL=https://your-domain.com    # optional, shown on openrouter.ai rankings
OPENROUTER_SITE_NAME=Memorae                   # optional

# ── MinIO / object storage (media bucket) ─────────────────────────────────────
# Under docker compose these are set automatically (endpoint=minio:9000, keys
# from MINIO_ROOT_USER/PASSWORD above) — leave them blank. Only fill these in for
# a bare (non-Docker) run against an external MinIO/S3.
MINIO_ENDPOINT=                        # host:port, no scheme, e.g. localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=memorae-media
MINIO_SECURE=false                     # true when MinIO is served over HTTPS
MINIO_REGION=                          # optional

# ── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ── Toon (AI Persona) ────────────────────────────────────────────────────────
TOON_NAME=Memo
TOON_PERSONA=friendly_assistant   # friendly_assistant | professional | casual

# ── Reminders ────────────────────────────────────────────────────────────────
REMINDER_CHECK_INTERVAL_MINUTES=1
DEFAULT_TIMEZONE=UTC
